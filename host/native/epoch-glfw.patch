+// Epoch: owned targets must not create a second visible top-level or steal
+// focus while loading. The coordinator enables this only in child processes;
+// after SetParent plus WS_CHILD, normal showing/focus works again.
+static GLFWbool epochAwaitingParent(_GLFWwindow* window)
+{
+    WCHAR enabled[2];
+    if (GetEnvironmentVariableW(L"EPOCH_HIDDEN_START", enabled, 2) != 1 ||
+        enabled[0] != L'1')
+        return GLFW_FALSE;
+    return !(GetWindowLongW(window->win32.handle, GWL_STYLE) & WS_CHILD) ||
+           !GetParent(window->win32.handle);
+}
